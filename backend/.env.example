APP_NAME=VastrAI API
ENVIRONMENT=development
API_PREFIX=/api/v1

SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

DATABASE_URL=postgresql+psycopg2://vastrai:vastrai@localhost:5434/vastrai

REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_RESULT_BACKEND=redis://localhost:6380/0

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_USE_PRIVATE=false

PERSON_FOLDER=/vastrai/person/
FABRIC_FOLDER=/vastrai/fabric/
RESULTS_FOLDER=/vastrai/results/

# AI Provider (mock | catvton | idmvton | gemini | flux | openai)
AI_PROVIDER=mock
# Legacy fallback
TRY_ON_PROVIDER=mock
# Workflow orchestration engine: 'pipeline' (existing stage loop) or
# 'langgraph' (LangGraph state machine in services.workflow).
AI_WORKFLOW_ENGINE=pipeline
# Optional: pin the image generation backend used via services.image_gen
# (gemini | flux | openai). Defaults to AI_PROVIDER.
IMAGE_GEN_BACKEND=

# Gemini (real AI image generation - requires a valid key).
# Without it the gemini provider fails honestly with ProviderConfigurationError.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT=180

# FLUX (real AI image generation via a FLUX-compatible image API).
# Empty endpoint -> the flux provider fails honestly (no fake results).
FLUX_ENDPOINT=
FLUX_API_KEY=
FLUX_MODEL=flux-dev
FLUX_TIMEOUT=300

# OpenAI (real AI image generation via the Images API, gpt-image-2).
# Without a key the openai provider fails honestly (no fake results).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-image-2
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=300

# Real-model endpoints. Empty -> CatVTON/IDM-VTON fail honestly (no fake results).
AI_GARMENT_GENERATION_ENDPOINT=
AI_TRYON_GENERATION_ENDPOINT=

# Pipeline quality / retry behaviour
IDENTITY_MIN_SCORE=0.0
TRY_ON_MAX_RETRIES=4
RETRY_BACKOFF_BASE=5
RETRY_MAX_DELAY=60

CORS_ORIGINS=*

# Password reset email via Gmail API. Keep all values server-side.
EMAIL_PROVIDER=gmail
EMAIL_FROM=VastrAI <ramnarayan84@gmail.com>
PASSWORD_RESET_URL=vastrai://reset-password
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SENDER_EMAIL=ramnarayan84@gmail.com
